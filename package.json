{
  "name": "haunted-oncall",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "basic": "cd examples/basic && tsx agent.ts",
    "demo": "tsx demo.ts",
    "clear-memory": "tsx scripts/clear-memory.ts",
    "check": "tsc --noEmit",
    "build": "esbuild agent.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/agent.js"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-s3": "3.1132.0",
    "@aws-sdk/client-secrets-manager": "3.1132.0",
    "@aws-sdk/credential-providers": "3.1132.0",
    "@aws/aws-distro-opentelemetry-node-autoinstrumentation": "0.13.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@smithy/node-http-handler": "4.13.0",
    "@smithy/protocol-http": "5.3.5",
    "@smithy/signature-v4": "5.3.5",
    "@strands-agents/harness": "0.3.1",
    "@strands-agents/sdk": "1.22.0",
    "bedrock-agentcore": "0.4.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1132.0",
    "@aws-sdk/client-cloudformation": "3.1132.0",
    "@aws-sdk/client-cloudwatch": "3.1132.0",
    "@aws-sdk/client-eventbridge": "3.1132.0",
    "@aws-sdk/client-lambda": "3.1132.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "^5.9.3"
  }
}
